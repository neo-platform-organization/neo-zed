{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "neo",
  "rules": {
    "document": {
      "type": "SYMBOL",
      "name": "object"
    },
    "object": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "_token"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "label"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "payload"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "object"
              },
              {
                "type": "SYMBOL",
                "name": "edge"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "label": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#[^\\s()>]+"
      }
    },
    "payload": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": ":object"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": ":integer"
            },
            {
              "type": "FIELD",
              "name": "integer",
              "content": {
                "type": "SYMBOL",
                "name": "_token"
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": ":boolean"
            },
            {
              "type": "FIELD",
              "name": "boolean",
              "content": {
                "type": "SYMBOL",
                "name": "_token"
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": ":text"
            },
            {
              "type": "FIELD",
              "name": "text",
              "content": {
                "type": "SYMBOL",
                "name": "_token"
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": ":primitive"
            },
            {
              "type": "FIELD",
              "name": "primitive",
              "content": {
                "type": "SYMBOL",
                "name": "_token"
              }
            }
          ]
        }
      ]
    },
    "edge": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "_token"
          }
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "_token"
          }
        },
        {
          "type": "FIELD",
          "name": "rights",
          "content": {
            "type": "SYMBOL",
            "name": "_token"
          }
        }
      ]
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "bare"
        }
      ]
    },
    "bare": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\s()>\"\\x00][^\\s()>\\x00]*"
      }
    },
    "string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "escape"
              },
              {
                "type": "SYMBOL",
                "name": "string_content"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "string_content": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\"\\\\\\x00-\\x1f]+"
      }
    },
    "escape": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\\\[\"\\\\nrt]"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": ">"
          },
          {
            "type": "PATTERN",
            "value": "[^\\n]*"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[\\s\\u000b\\u000c]+"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}